# backend/.env.example — Backend environment variables (copy to backend/.env)
# Fill in real secrets locally (do NOT commit real secrets).

APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./storage/interview_coach.db
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile
AUDIO_UPLOAD_DIR=./storage/audio
SECRET_KEY=your_secret_key_here
ALLOWED_ORIGINS=http://localhost:5173
