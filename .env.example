# .env.example — Combined template for this monorepo
# Copy the relevant section into the service .env file and fill values.
# DO NOT commit real secrets. Replace placeholders with real values in your local .env files.

# ------------------ BACKEND (backend/.env) ------------------
# App environment: development | production
APP_ENV=development

# Database (example uses SQLite for local dev)
DATABASE_URL=sqlite+aiosqlite:///./storage/interview_coach.db

# LLM / API keys (replace with your keys; keep them secret)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash

# Whisper configuration
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu  # set to `cuda` if you have GPU/CUDA available

# File storage for uploaded audio
AUDIO_UPLOAD_DIR=./storage/audio

# App / security
SECRET_KEY=your_secret_key_here
ALLOWED_ORIGINS=http://localhost:5173

# ------------------ FRONTEND (frontend/.env) ------------------
# Vite-based frontend uses VITE_ prefix
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Notes
# - Copy backend/.env.example -> backend/.env and fill secrets
# - Copy frontend/.env.example -> frontend/.env and adjust VITE_API_BASE_URL when deploying
# End of file
